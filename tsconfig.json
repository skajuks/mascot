{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "paths": {
      "@robertskalve/mascot": [
        "./src/index.ts"
      ],
      "@robertskalve/mascot/react": [
        "./src/react/index.tsx"
      ]
    }
  },
  "include": [
    "src",
    "site/src",
    "site/vite.config.ts"
  ]
}
